# Copy to .dev.vars for local wrangler, and use the same names with:
#   npx wrangler secret put <NAME>
# For command registration, also export these in your shell or put them in .env
# (register.ts reads process.env).

DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Optional: your server ID so slash commands appear instantly
DISCORD_GUILD_ID=
